{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-toolchain.cmake",
      "environment": {
        "WORKSPACE_ROOT": "$penv{WORKSPACE_ROOT}",
        "LLVM_VERSION": "$penv{LLVM_VERSION}",
        "LLVM_ROOT": "$penv{LLVM_ROOT}",
        "GCC_VERSION": "$penv{GCC_VERSION}",
        "GCC_ROOT": "$penv{GCC_ROOT}",
        "BINUTILS_VERSION": "$penv{BINUTILS_VERSION}",
        "BINUTILS_ROOT": "$penv{BINUTILS_ROOT}",
        "LIBBACKTRACE_ROOT": "$penv{LIBBACKTRACE_ROOT}",
        "CMAKE_ROOT": "$penv{CMAKE_ROOT}",
        "CCACHE_ROOT": "$penv{CCACHE_ROOT}",
        "MOLD_ROOT": "$penv{MOLD_ROOT}",
        "LCOV_ROOT": "$penv{LCOV_ROOT}",
        "BOOST_ROOT": "$penv{BOOST_ROOT}",
        "PATH": "$penv{PATH}",
        "LD_LIBRARY_PATH": "$penv{LD_LIBRARY_PATH}",
        "CPATH": "$penv{CPATH}",
        "LIBRARY_PATH": "$penv{LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_OPTIMIZE_DEPENDENCIES": "ON",
        "BOOST_ROOT": "$env{BOOST_ROOT}",
        "Boost_ROOT": "$env{BOOST_ROOT}",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/_build/.fetchcontent"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "Debug build with assertions and no optimizations",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LAB_DEBUG": "ON",
        "LAB_RELEASE": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimized release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LAB_DEBUG": "OFF",
        "LAB_RELEASE": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "ASan",
      "description": "Debug build with Address/Leak/UB sanitizers",
      "cacheVariables": {
        "LAB_ASAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "displayName": "TSan",
      "description": "Debug build with Thread sanitizer",
      "cacheVariables": {
        "LAB_TSAN": "ON"
      }
    },
    {
      "name": "clang",
      "inherits": "debug",
      "displayName": "Clang",
      "description": "Debug build with Clang + Address/UB sanitizers",
      "toolchainFile": "${sourceDir}/cmake/clang-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--gcc-toolchain=$env{GCC_ROOT}",
        "LAB_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "clang", "configurePreset": "clang" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "clang", "inherits": "base", "configurePreset": "clang" }
  ]
}
