if(DEFINED ENV{GCC_ROOT})
  find_program(CMAKE_C_COMPILER NAMES gcc HINTS "$ENV{GCC_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
  find_program(CMAKE_CXX_COMPILER NAMES g++ HINTS "$ENV{GCC_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
else()
  find_program(CMAKE_C_COMPILER NAMES gcc REQUIRED)
  find_program(CMAKE_CXX_COMPILER NAMES g++ REQUIRED)
endif()
